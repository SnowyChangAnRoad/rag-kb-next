# 复制本文件为 .env，填入真实 key。.env 含密钥，禁止提交 git。

# ---------------- 被测模型：DeepSeek ----------------
# DeepSeek 开放平台：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------- 裁判模型：阿里云百炼 / MaaS ----------------
# OpenAI 兼容模式（本项目用 openai SDK 直连，不需要 dashscope SDK）
# 本账号用的是 MaaS 专属端点，不是公共 dashscope.aliyuncs.com
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
DASHSCOPE_BASE_URL=https://ws-rbtvfl1mut97g4dq.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ⚠️ 固定模型名，不许换成 -latest 别名：别名背后会静默换版，历史分数不可比（judge drift）。
# qwen3.8-max 是深度思考模型，代码里已用 extra_body={"enable_thinking": false} 显式关闭思考链。
JUDGE_MODEL=qwen3.8-max
